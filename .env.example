# Supabase
SUPABASE_URL=https://xxxx.com/
SUPABASE_SERVICE_ROLE_KEY=SUPABASE_SERVICE_ROLE_KEY

# Binance Futures
# Mainnet: https://fapi.binance.com
# Testnet: https://testnet.binancefuture.com
BINANCE_BASE_URL=https://testnet.binancefuture.com
BINANCE_API_KEY=BINANCE_API_KEY
BINANCE_API_SECRET=BINANCE_API_SECRET

# Trend webhook secret
TREND_WEBHOOK_SECRET=TREND_WEBHOOK_SECRET

# Port (Railway จะ set ให้อัตโนมัติ)
PORT=3000

# Market data สำหรับ indicator engine (ใช้ mainnet เสมอ แม้เทรดบน testnet)
# kline stream ของ USDⓈ-M อยู่ใต้ route /market
BINANCE_MARKET_REST=https://fapi.binance.com
BINANCE_MARKET_WS=wss://fstream.binance.com/market
